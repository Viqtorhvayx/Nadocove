# NadoCove's Builder ID, once approved via https://tally.so/r/0QO4oy.
# Every order placed from the trade panel carries this ID + fee rate.
# Leave unset (defaults to 0 = no builder) while developing.
NEXT_PUBLIC_BUILDER_ID=0

# Fee rate in 0.1bps units (10 = 1bps = 0.01%). Must be within the bounds
# configured on your builder record. Only meaningful when BUILDER_ID > 0.
NEXT_PUBLIC_BUILDER_FEE_RATE=0

# Optional: enables the WalletConnect connector (get a project ID at
# https://cloud.walletconnect.com). Injected wallets work without this.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
