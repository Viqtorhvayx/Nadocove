# NadoCove's Builder ID, once approved via https://tally.so/r/0QO4oy.
# Every order placed from the trade panel carries this ID + fee rate.
# Leave unset (defaults to 0 = no builder) while developing.
NEXT_PUBLIC_BUILDER_ID=0

# Fee rate in 0.1bps units (10 = 1bps = 0.01%). Must be within the bounds
# configured on your builder record. Only meaningful when BUILDER_ID > 0.
NEXT_PUBLIC_BUILDER_FEE_RATE=0

# Required by RainbowKit for WalletConnect-based wallets and its mobile QR
# flow — get a free project ID at https://cloud.walletconnect.com. Injected
# wallets (MetaMask, Rabby, etc.) still work with the placeholder default in
# src/lib/wagmi.ts, but set this before deploying for real.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# This app's own absolute URL, used to build server-side proxy URLs for
# Nado's RPC/gateway/archive APIs (they don't send CORS headers for
# browser origins — see src/lib/nado-endpoints.ts). Set this to your real
# deployed URL once on Vercel; defaults to localhost for local dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
